{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "crons": [
    { "path": "/api/cron/platform-health", "schedule": "0 8 * * *" },
    { "path": "/api/cron/daily-summary", "schedule": "0 9 * * *" },
    { "path": "/api/cron/content-package", "schedule": "0 17 * * *" }
  ],
  "routes": [
    { "src": "/api/health", "dest": "/api-health.js" },
    { "src": "/api/cron/platform-health", "dest": "/api-platform-health.js" },
    { "src": "/api/cron/daily-summary", "dest": "/api-daily-summary.js" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
