{
  "name": "Daily Scraping Pipeline",
  "description": "Run daily intelligence scraping and market analysis at 9 AM EST",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 13 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_scraping_pipeline",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "pipelineOrchestrator",
            "args": {
              "workspaceId": "current",
              "pipelineId": "daily-intelligence-scrape",
              "config": {
                "scrapeUrls": [
                  "https://techcrunch.com",
                  "https://www.forbes.com/ai",
                  "https://www.producthunt.com"
                ],
                "runSimulation": true,
                "analyzeIntelligence": true,
                "generateReport": true,
                "simulationType": "Market Entry"
              }
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "pipelineOrchestrator"
  }
}