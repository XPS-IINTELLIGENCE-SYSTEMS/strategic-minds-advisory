{
  "name": "Monitor CodeOperations for PR Reviews",
  "description": "Automatically analyzes new code operations and posts performance/security reviews to GitHub PRs",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"completed\") and (.trigger.data.operation_type == \"create_file\" or .trigger.data.operation_type == \"modify_file\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "CodeOperation"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "monitor_codeoperations_for_pr_reviews",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "monitorCodeOperationsForPR",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "monitorCodeOperationsForPR"
  }
}