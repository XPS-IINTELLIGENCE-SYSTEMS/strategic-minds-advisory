{
  "name": "Hourly Keyword Alert Monitor",
  "description": "Check for critical market signals hourly",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 1,
      "interval_unit": "hours",
      "interval_anchor": "2026-04-23T18:48:24.715000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "hourly_keyword_alert_monitor",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "groqChat",
            "args": {
              "messages": [
                {
                  "role": "user",
                  "content": "Monitor recent intelligence for critical keywords: 'funding', 'acquisition', 'market disruption', 'new competitor'. Alert if found."
                }
              ],
              "systemPrompt": "You are a market alert monitor. Scan intelligence and flag high-impact signals."
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "groqChat"
  }
}